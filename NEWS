const StudentsView = () => {
  const [students, setStudents] = useState(initialStudents);
  const [searchTerm, setSearchTerm] = useState('');
  const [selectedStudent, setSelectedStudent] = useState(null);
  const [loading, setLoading] = useState(false);
  const [careerAdvice, setCareerAdvice] = useState({});
  const [loadingCareer, setLoadingCareer] = useState(null);
  const filteredStudents = students.filter(student => student.nameKh.toLowerCase().includes(searchTerm.toLowerCase()) || student.id.toLowerCase().includes(searchTerm.toLowerCase()) || student.nameEn.toLowerCase().includes(searchTerm.toLowerCase()));
  const handleGenerateCareerAdvice = async (student) => { if (careerAdvice[student.id]) { const newAdvice = {...careerAdvice}; delete newAdvice[student.id]; setCareerAdvice(newAdvice); return; } setLoadingCareer(student.id); const prompt = `Suggest 3 potential career paths and 1 key soft skill to improve for a university student majoring in "${student.major}" (${student.degreeLevel}). Language: Khmer. Use emojis.`; const response = await generateGeminiResponse(prompt); setCareerAdvice(prev => ({...prev, [student.id]: response})); setLoadingCareer(null); };
  return (<div className="space-y-6"><div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4"><h2 className="text-2xl font-bold text-slate-800">បញ្ជី និងប្រវត្តិរូបនិស្សិត</h2><button className="flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"><UserPlus size={18} className="mr-2" /> ចុះឈ្មោះនិស្សិតថ្មី</button></div><div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden"><div className="p-4 border-b border-slate-200 bg-slate-50 flex items-center"><div className="relative w-full max-w-md"><Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400" size={18} /><input type="text" placeholder="ស្វែងរកតាមឈ្មោះ ឬអត្តលេខ..." className="w-full pl-10 pr-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} /></div></div><div className="overflow-x-auto"><table className="w-full text-left border-collapse"><thead><tr className="bg-slate-50 text-slate-600 text-sm uppercase"><th className="p-4 font-semibold border-b border-slate-200">អត្តលេខ</th><th className="p-4 font-semibold border-b border-slate-200">គោត្តនាម-នាម (ខ្មែរ)</th><th className="p-4 font-semibold border-b border-slate-200">ឈ្មោះឡាតាំង</th><th className="p-4 font-semibold border-b border-slate-200">ភេទ</th><th className="p-4 font-semibold border-b border-slate-200">កម្រិត/ឆ្នាំ</th><th className="p-4 font-semibold border-b border-slate-200">ជំនាញ</th><th className="p-4 font-semibold border-b border-slate-200">ស្ថានភាព</th><th className="p-4 font-semibold border-b border-slate-200 text-right">សកម្មភាព</th></tr></thead><tbody className="divide-y divide-slate-100">{filteredStudents.length > 0 ? (filteredStudents.map((student) => (<React.Fragment key={student.id}><tr className="hover:bg-slate-50 transition-colors text-sm text-slate-700"><td className="p-4 font-medium text-blue-600">{student.id}</td><td className="p-4 font-bold text-slate-800">{student.nameKh}</td><td className="p-4 text-slate-500 uppercase">{student.nameEn}</td><td className="p-4">{student.gender}</td><td className="p-4 text-xs"><div>{student.degreeLevel}</div><div className="text-slate-500">{student.yearLevel}</div></td><td className="p-4">{student.major}</td><td className="p-4"><span className={`px-2 py-1 rounded-full text-xs font-medium ${student.status === 'សកម្ម' ? 'bg-green-100 text-green-700' : student.status === 'ព្យួរ' ? 'bg-yellow-100 text-yellow-700' : 'bg-slate-100 text-slate-700'}`}>{student.status}</span></td><td className="p-4 text-right flex justify-end space-x-2"><button onClick={() => setSelectedStudent(student)} className="flex items-center px-3 py-1 bg-blue-50 text-blue-600 rounded hover:bg-blue-100 transition-colors text-xs font-medium border border-blue-200"><Eye size={14} className="mr-1" /> ពិនិត្យ</button><button onClick={() => handleGenerateCareerAdvice(student)} className={`flex items-center px-3 py-1 rounded transition-colors text-xs font-medium border ${careerAdvice[student.id] ? 'bg-teal-100 text-teal-700 border-teal-200' : 'bg-white text-teal-600 border-teal-200 hover:bg-teal-50'}`} title="AI Career Advice">{loadingCareer === student.id ? <Loader2 size={14} className="animate-spin" /> : <Compass size={14} />}</button></td></tr>{careerAdvice[student.id] && (<tr><td colSpan="8" className="p-4 bg-teal-50 border-b border-teal-100"><div className="space-y-2 relative"><div className="flex items-center justify-between"><h4 className="font-bold text-teal-800 flex items-center text-xs uppercase tracking-wide"><Brain size={14} className="mr-2" /> ការណែនាំអំពីអាជីពសម្រាប់ជំនាញ {student.major}</h4><button onClick={() => handleGenerateCareerAdvice(student)} className="text-slate-400 hover:text-slate-600"><X size={16} /></button></div><div className="bg-white p-3 rounded border border-teal-200 text-slate-700 whitespace-pre-wrap text-sm leading-relaxed shadow-sm">{careerAdvice[student.id]}</div></div></td></tr>)}</React.Fragment>))) : (<tr><td colSpan="8" className="p-8 text-center text-slate-500">មិនមានទិន្នន័យ</td></tr>)}</tbody></table></div></div>{selectedStudent && (<div className="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4"><div className="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto relative"><div className="sticky top-0 bg-white border-b border-slate-200 p-4 flex justify-between items-center z-10"><h3 className="text-xl font-bold text-slate-800 flex items-center"><User size={24} className="mr-2 text-blue-600" /> ប្រវត្តិរូបសង្ខេបនិស្សិត (Student Profile)</h3><button onClick={() => setSelectedStudent(null)} className="p-2 bg-slate-100 rounded-full hover:bg-slate-200 text-slate-600"><X size={20} /></button></div><div className="p-6 space-y-8"><div className="flex flex-col md:flex-row gap-6 items-start"><div className="w-32 h-32 bg-slate-200 rounded-lg flex items-center justify-center text-slate-400 self-center md:self-start"><Users size={48} /></div><div className="flex-1 space-y-2"><div className="flex flex-wrap gap-2 mb-2"><span className={`px-2 py-1 rounded text-xs font-bold uppercase ${selectedStudent.status === 'សកម្ម' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}`}>{selectedStudent.status}</span><span className="px-2 py-1 bg-blue-100 text-blue-700 rounded text-xs font-bold uppercase">ID: {selectedStudent.id}</span></div><h2 className="text-2xl font-bold text-slate-900">{selectedStudent.nameKh}</h2><h3 className="text-lg font-medium text-slate-500 uppercase">{selectedStudent.nameEn}</h3><div className="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 text-sm text-slate-700"><div className="flex items-center"><Phone size={16} className="mr-2 text-slate-400"/> {selectedStudent.phone}</div><div className="flex items-center"><CreditCard size={16} className="mr-2 text-slate-400"/> NID: {selectedStudent.nid}</div><div className="flex items-center"><Briefcase size={16} className="mr-2 text-slate-400"/> មុខរបរ: {selectedStudent.job}</div><div className="flex items-center"><MapPin size={16} className="mr-2 text-slate-400"/> {selectedStudent.pob}</div></div></div></div><div className="border-t border-slate-100 my-4"></div><div className="grid grid-cols-1 lg:grid-cols-2 gap-8"><div className="bg-slate-50 p-5 rounded-xl border border-slate-200"><h4 className="font-bold text-blue-800 mb-4 flex items-center"><GraduationCap size={18} className="mr-2" /> ព័ត៌មានសិក្សា (Academic Info)</h4><div className="grid grid-cols-2 gap-4 text-sm"><div><p className="text-slate-500 text-xs">កម្រិតសិក្សា</p><p className="font-medium">{selectedStudent.degreeLevel}</p></div><div><p className="text-slate-500 text-xs">ជំនាញ (Major)</p><p className="font-medium text-blue-700">{selectedStudent.major}</p></div><div><p className="text-slate-500 text-xs">ឆ្នាំទី</p><p className="font-medium">{selectedStudent.yearLevel}</p></div><div><p className="text-slate-500 text-xs">ឆមាសទី</p><p className="font-medium">{selectedStudent.semester}</p></div><div><p className="text-slate-500 text-xs">ជំនាន់ទី</p><p className="font-medium">{selectedStudent.batch}</p></div><div><p className="text-slate-500 text-xs">វគ្គសិក្សា</p><p className="font-medium">{selectedStudent.session}</p></div></div></div><div className="bg-slate-50 p-5 rounded-xl border border-slate-200"><h4 className="font-bold text-blue-800 mb-4 flex items-center"><UserCog size={18} className="mr-2" /> ព័ត៌មានលម្អិត (Personal Details)</h4><div className="grid grid-cols-2 gap-4 text-sm"><div><p className="text-slate-500 text-xs">ភេទ</p><p className="font-medium">{selectedStudent.gender}</p></div><div><p className="text-slate-500 text-xs">ថ្ងៃខែឆ្នាំកំណើត</p><p className="font-medium">{selectedStudent.dob}</p></div><div><p className="text-slate-500 text-xs">អាយុ (ស្វ័យប្រវត្តិ)</p><p className="font-medium text-green-600">{calculateAge(selectedStudent.dob)} ឆ្នាំ</p></div><div><p className="text-slate-500 text-xs">ទីកន្លែងកំណើត</p><p className="font-medium line-clamp-1" title={selectedStudent.pob}>{selectedStudent.pob}</p></div></div></div></div><div className="grid grid-cols-1 lg:grid-cols-2 gap-8"><div className="border border-slate-200 rounded-xl p-5"><h4 className="font-bold text-slate-700 mb-4 border-b pb-2">ប្រវត្តិសិក្សា (Educational Background)</h4><div className="mb-4"><h5 className="text-sm font-bold text-slate-600 mb-2">• កម្រិតវប្បធម៌ទុតិយភូមិ (High School)</h5><div className="grid grid-cols-2 gap-x-4 gap-y-2 text-sm pl-2 border-l-2 border-blue-200"><div className="text-slate-500">ឈ្មោះសាលា:</div><div>{selectedStudent.highSchool}</div><div className="text-slate-500">មណ្ឌលប្រឡង:</div><div>{selectedStudent.examCenter}</div><div className="text-slate-500">ឆ្នាំប្រឡង:</div><div>{selectedStudent.examYear}</div><div className="text-slate-500">លេខ ស.ប:</div><div>{selectedStudent.certNo}</div><div className="text-slate-500">លទ្ធផល:</div><div className={`font-bold ${selectedStudent.examResult === 'ជាប់' ? 'text-green-600' : 'text-red-600'}`}>{selectedStudent.examResult}</div></div></div><div><h5 className="text-sm font-bold text-slate-600 mb-2">• កម្រិតមហាវិទ្យាល័យ (Previous Degree)</h5><div className="grid grid-cols-2 gap-x-4 gap-y-2 text-sm pl-2 border-l-2 border-purple-200"><div className="text-slate-500">កម្រិត១:</div><div>{selectedStudent.prevDegreeLevel1}</div><div className="text-slate-500">កម្រិត២:</div><div>{selectedStudent.prevDegreeLevel2}</div><div className="text-slate-500">មកពីសាលា:</div><div>{selectedStudent.prevSchool}</div><div className="text-slate-500">លេខយោង:</div><div>{selectedStudent.prevRef}</div></div></div></div><div className="border border-slate-200 rounded-xl p-5 bg-orange-50/30"><h4 className="font-bold text-slate-700 mb-4 border-b pb-2">គ្រួសារ និង អាសយដ្ឋាន</h4><div className="mb-4"><div className="grid grid-cols-1 sm:grid-cols-2 gap-4"><div className="bg-white p-3 rounded border border-orange-100"><h5 