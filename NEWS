                              <button className="flex items-center px-3 py-1.5 bg-slate-100 text-slate-500 rounded-lg hover:bg-slate-200 text-xs font-medium border border-slate-200">
                                <PlusCircle size={14} className="mr-1" />
                                បន្ថែម
                              </button>
                            </div>
                          )}
                        </div>
                      );
                    })
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>
      <div className="bg-blue-50 p-4 rounded-xl border border-blue-100 flex flex-col md:flex-row gap-6 text-sm text-slate-700">
         <div className="flex items-start">
            <Clock className="text-blue-600 mr-2 mt-0.5" size={18} />
