const TeachersView = () => {
    const [reviewingTeacher, setReviewingTeacher] = useState(null);
    const [generatedReview, setGeneratedReview] = useState('');
    const [loadingReview, setLoadingReview] = useState(false);
    const handleGenerateReview = async (teacher) => { if (reviewingTeacher === teacher.id && generatedReview) { setReviewingTeacher(null); return; } setReviewingTeacher(teacher.id); setLoadingReview(true); setGeneratedReview(''); const prompt = `Write a professional performance review in Khmer for ${teacher.name}. Subject: ${teacher.subject}. Context: Be constructive. Keep it concise (3-4 bullet points). Use emojis.`; const response = await generateGeminiResponse(prompt); setGeneratedReview(response); setLoadingReview(false); };
    return (<div className="space-y-6"><div className="flex justify-between items-center"><h2 className="text-2xl font-bold text-slate-800">គ្រូបង្រៀន</h2><button className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">បន្ថែមគ្រូ</button></div><div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">{initialTeachers.map((teacher) => (<div key={teacher.id} className="bg-white p-6 rounded-xl shadow-sm border border-slate-200 flex flex-col items-center text-center relative"><div className="w-20 h-20 bg-slate-200 rounded-full flex items-center justify-center text-2xl mb-4 text-slate-400"><Users /></div><h3 className="text-lg font-bold text-slate-800">{teacher.name}</h3><p className="text-blue-600 text-sm font-medium mb-1">{teacher.subject}</p><p className="text-slate-500 text-xs mb-2">{teacher.phone}</p><div className="bg-blue-50 px-3 py-1 rounded-full text-blue-700 text-xs font-bold mb-4">${teacher.ratePerHour} / ម៉ោង</div><div className="flex space-x-2 w-full"><button className="flex-1 py-2 border border-slate-200 rounded-lg text-slate-600 hover:bg-slate-50 text-sm font-medium">ប្រវត្តិរូប</button><button onClick={() => handleGenerateReview(teacher)} className={`flex-1 py-2 rounded-lg text-sm font-medium flex items-center justify-center transition-colors ${reviewingTeacher === teacher.id ? 'bg-purple-100 text-purple-700 border border-purple-200' : 'bg-purple-600 text-white hover:bg-purple-700'}`}>{reviewingTeacher === teacher.id && loadingReview ? <Loader2 size={16} className="animate-spin" /> : <MessageSquare size={16} className="mr-1" />} AI វាយតម្លៃ</button></div>{reviewingTeacher === teacher.id && !loadingReview && generatedReview && (<div className="absolute top-full left-0 right-0 z-10 mt-2 p-4 bg-white border border-purple-200 rounded-xl shadow-xl text-left text-sm text-slate-700 animate-in fade-in slide-in-from-top-2"><div className="flex justify-between items-center mb-2"><h4 className="font-bold text-purple-700 flex items-center"><Sparkles size={14} className="mr-1"/> ការវាយតម្លៃដោយ AI</h4><button onClick={() => setReviewingTeacher(null)}><X size={14} className="text-slate-400 hover:text-slate-600"/></button></div><div className="whitespace-pre-wrap leading-relaxed text-xs">{generatedReview}</div></div>)}</div>))}</div></div>)
};

const CoursesView = () => {
    const [topic, setTopic] = useState('');
    const [loading, setLoading] = useState(false);
    const [syllabus, setSyllabus] = useState('');
    const [lessonTopic, setLessonTopic] = useState('');
    const [lessonDuration, setLessonDuration] = useState('60');
    const [lessonPlan, setLessonPlan] = useState('');
    const [loadingLesson, setLoadingLesson] = useState(false);
    const handleGenerateSyllabus = async () => { if (!topic) return; setLoading(true); setSyllabus(''); const prompt = `Generate a 4-week structured course syllabus for "${topic}" in Khmer. Use bullet points and emojis.`; const result = await generateGeminiResponse(prompt); setSyllabus(result); setLoading(false); };
    const handleGenerateLessonPlan = async () => { if (!lessonTopic) return; setLoadingLesson(true); setLessonPlan(''); const prompt = `Create a detailed lesson plan in Khmer for "${lessonTopic}". Duration: ${lessonDuration} minutes. Structure: Objective, Introduction, Main Activity, Assessment, Materials. Use emojis.`; const result = await generateGeminiResponse(prompt); setLessonPlan(result); setLoadingLesson(false); };
    return (<div className="space-y-6"><h2 className="text-2xl font-bold text-slate-800 flex items-center"><Sparkles className="text-yellow-500 mr-2" /> ជំនួយការវគ្គសិក្សាឆ្លាតវៃ (AI Assistant)</h2><div className="grid grid-cols-1 lg:grid-cols-2 gap-6"><div className="bg-white p-6 rounded-xl shadow-sm border border-slate-200 h-fit"><h3 className="font-bold text-slate-700 mb-4 flex items-center"><FileText className="mr-2 text-blue-500" /> បង្កើតកម្មវិធីសិក្សា (Syllabus)</h3><div className="space-y-4 mb-4"><div><label className="block text-sm font-medium text-slate-600 mb-1">ឈ្មោះវគ្គសិក្សា</label><input type="text" className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="ឧទាហរណ៍: មូលដ្ឋានគ្រឹះ React..." value={topic} onChange={(e) => setTopic(e.target.value)} /></div><button onClick={handleGenerateSyllabus} disabled={loading || !topic} className={`w-full flex items-center justify-center py-2.5 rounded-lg text-white font-medium transition-all ${loading || !topic ? 'bg-slate-300 cursor-not-allowed' : 'bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-md'}`}>{loading ? <Loader2 className="animate-spin mr-2" size={18} /> : <Sparkles className="mr-2" size={18} />} បង្កើតកម្មវិធីសិក្សា</button></div><div className="bg-slate-50 p-4 rounded-lg border border-slate-200 min-h-[200px]">{loading ? (<div className="flex flex-col items-center justify-center h-48 text-slate-400"><Loader2 size={32} className="animate-spin text-blue-500 mb-2" /><p className="text-xs">កំពុងរៀបចំ...</p></div>) : syllabus ? (<div className="prose prose-sm max-w-none text-slate-700 whitespace-pre-wrap leading-relaxed">{syllabus}</div>) : (<div className="flex flex-col items-center justify-center h-48 text-slate-400"><FileText size={32} className="mb-2 opacity-50" /><p className="text-xs">លទ្ធផលនឹងបង្ហាញនៅទីនេះ</p></div>)}</div></div><div className="bg-white p-6 rounded-xl shadow-sm border border-slate-200 h-fit"><h3 className="font-bold text-slate-700 mb-4 flex items-center"><BookOpenCheck className="mr-2 text-green-600" /> បង្កើតកិច្ចតែងការបង្រៀន (Lesson Plan)</h3><div className="space-y-4 mb-4"><div className="flex gap-3"><div className="flex-1"><label className="block text-sm font-medium text-slate-600 mb-1">ប្រធានបទមេរៀន</label><input type="text" className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:outline-none" placeholder="ឧទាហរណ៍: ការប្រើប្រាស់ State..." value={lessonTopic} onChange={(e) => setLessonTopic(e.target.value)} /></div><div className="w-24"><label className="block text-sm font-medium text-slate-600 mb-1">នាទី</label><input type="number" className="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:outline-none" value={lessonDuration} onChange={(e) => setLessonDuration(e.target.value)} /></div></div><button onClick={handleGenerateLessonPlan} disabled={loadingLesson || !lessonTopic} className={`w-full flex items-center justify-center py-2.5 rounded-lg text-white font-medium transition-all ${loadingLesson || !lessonTopic ? 'bg-slate-300 cursor-not-allowed' : 'bg-gradient-to-r from-green-600 to-teal-600 hover:from-green-700 hover:to-teal-700 shadow-md'}`}>{loadingLesson ? <Loader2 className="animate-spin mr-2" size={18} /> : <Sparkles className="mr-2" size={18} />} បង្កើតកិច្ចតែងការ</button></div><div className="bg-slate-50 p-4 rounded-lg border border-slate-200 min-h-[200px]">{loadingLesson ? (<div className="flex flex-col items-center justify-center h-48 text-slate-400"><Loader2 size={32} className="animate-spin text-green-500 mb-2" /><p className="text-xs">កំពុងរៀបចំ...</p></div>) : lessonPlan ? (<div className="prose prose-sm max-w-none text-slate-700 whitespace-pre-wrap leading-relaxed">{lessonPlan}</div>) : (<div className="flex flex-col items-center justify-center h-48 text-slate-400"><BookOpenCheck size={32} className="mb-2 opacity-50" /><p className="text-xs">លទ្ធផលនឹងបង្ហាញនៅទីនេះ</p></div>)}</div></div></div></div>);
};

const LibraryDocsView = () => {
  const [filter, setFilter] = useState('All');
  const [searchTerm, setSearchTerm] = useState('');
  const [insightItem, setInsightItem] = useState(null);
  const [insightContent, setInsightContent] = useState('');
  const [isGeneratingInsight, setIsGeneratingInsight] = useState(false);
  const categories = [{ id: 'All', label: 'ទាំងអស់' }, { id: 'សៀវភៅមេរៀន', label: 'សៀវភៅសិក្សា' }, { id: 'លិខិតរដ្ឋបាល', label: 'លិខិតរដ្ឋបាល' }, { id: 'ផ្សេងៗ', label: 'ឯកសារផ្សេងៗ' }];
  const filteredItems = initialLibraryItems.filter(item => { const matchesFilter = filter === 'All' || item.type === filter; const matchesSearch = item.title.toLowerCase().includes(searchTerm.toLowerCase()); return matchesFilter && matchesSearch; });
  const handleGetInsight = async (item) => { if (insightItem === item.id) { setInsightItem(null); return; } setInsightItem(item.id); setIsGeneratingInsight(true); setInsightContent(''); const prompt = `Provide a brief summary and 3 key study topics in Khmer for "${item.title}". Category: ${item.category}.`; const response = await generateGeminiResponse(prompt); setInsightContent(response); setIsGeneratingInsight(false); };
  return (<div className="space-y-6"><div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4"><h2 className="text-2xl font-bold text-slate-800">បណ្ណាល័យ & ឃ្លាំងឯកសារ</h2><button className="flex items-center bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors shadow-sm"><PlusCircle size={18} className="mr-2" /> បញ្ចូលឯកសារថ្មី</button></div><div className="grid grid-cols-1 md:grid-cols-3 gap-6"><div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center"><div className="p-3 rounded-full bg-indigo-100 text-indigo-600 mr-4"><Library size={24} /></div><div><p className="text-slate-500 text-sm">សៀវភៅសរុប</p><h3 className="text-xl font-bold text-slate-800">1,250 ក្បាល</h3></div></div><div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center"><div className="p-3 rounded-full bg-orange-100 text-orange-600 mr-4"><Folder size={24} /></div><div><p className="text-slate-500 text-sm">លិខិតរដ្ឋបាល</p><h3 className="text-xl font-bold text-slate-800">340 ឯកសារ</h3></div></div><div className="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center"><div className="p-3 rounded-full bg-green-100 text-green-600 mr-4"><Archive size={24} /></div><div><p className="text-slate-500 text-sm">ឯកសារបម្រុងទុក</p><h3 className="text-xl font-bold text-slate-800">85 GB</h3></div></div></div><div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden"><div className="p-4 border-b border-slate-200 flex flex-col md:flex-row gap-4 justify-between items-center bg-slate-50"><div className="flex space-x-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0">{categories.map((cat) => (<button key={cat.id} onClick={() => setFilter(cat.id)} className={`px-3 py-1.5 rounded-md text-sm font-medium whitespace-nowrap transition-colors ${filter === cat.id ? 'bg-white text-blue-700 shadow-sm border border-slate-200' : 'text-slate-600 hover:bg-slate-200'}`}>{cat.label}</button>))}</div><div className="relative w-full md:w-64"><Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400" size={16} /><input type="text" placeholder="ស្វែងរកឯកសារ..." className="w-full pl-9 pr-4 py-1.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} /></div></div><div className="divide-y divide-slate-100">{filteredItems.length > 0 ? (filteredItems.map((item) => (<React.Fragment key={item.id}><div className={`p-4 hover:bg-slate-50 transition-colors flex flex-col md:flex-row items-start md:items-center justify-between gap-4 ${insightItem === item.id ? 'bg-indigo-50 hover:bg-indigo-50' : ''}`}><div className="flex items-start gap-4"><div className={`p-3 rounded-lg flex-shrink-0 ${item.type === 'សៀវភៅមេរៀន' ? 'bg-blue-100 text-blue-600' : item.type === 'លិខិតរដ្ឋបាល' ? 'bg-orange-100 text-orange-600' : 'bg-slate-100 text-slate-600'}`}>{item.type === 'សៀវភៅមេរៀន' ? <BookOpen size={20} /> : <FileText size={20} />}</div><div><h4 className="font-bold text-slate-800 text-sm md:text-base">{item.title}</h4><div className="flex flex-wrap gap-2 mt-1 text-xs text-slate-500"><span className="flex items-center"><span className="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span>{item.id}</span><span className="flex items-center"><span className="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span>{item.category}</span><span className="flex items-center"><span className="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span>{item.location}</span></div></div></div><div className="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end"><span className={`px-2.5 py-1 rounded-full text-xs font-medium ${item.status === 'មាន' || item.status === 'ឌីជីថល' || item.status === 'ច្បាប់ដើម' ? 'bg-green-100 text-green-700' : item.status === 'បានខ្ចី' ? 'bg-yellow-100 text-yellow-700' : 'bg-slate-100 text-slate-700'}`}>{item.status}</span><button onClick={() => handleGetInsight(item)} className={`p-2 rounded-full transition-colors ${insightItem === item.id ? 'text-indigo-600 bg-indigo-100' : 'text-slate-400 hover:text-indigo-600 hover:bg-indigo-50'}`} title="AI Insight"><Brain size={18} /></button><button className="text-slate-400 hover:text-blue-600"><Settings size={18} /></button></div></div>{insightItem === item.id && (<div className="px-16 pb-4 bg-indigo-50 border-b border-indigo-100"><div className="bg-white p-4 rounded-lg border border-indigo-100 shadow-sm"><h5 className="text-xs font-bold text-indigo-600 uppercase mb-2 flex items-center"><Sparkles size={12} className="mr-1" /> AI ជំនួយការស្រាវជ្រាវ (AI Research Assistant)</h5>{isGeneratingInsight ? (<div className="flex items-center text-indigo-400 text-sm py-2"><Loader2 size={16} className="animate-spin mr-2" /> កំពុងវិភាគឯកសារ...</div>) : (<div className="text-sm text-slate-700 whitespace-pre-wrap leading-relaxed">{insightContent}</div>)}</div></div>)}</React.Fragment>))) : (<div className="p-8 text-center text-slate-500"><Folder size={48} className="mx-auto mb-3 text-slate-300" /><p>មិនមានឯកសារនៅក្នុងផ្នែកនេះទេ</p></div>)}</div></div></div>);
};

// Main App Component
const App = () => {
  const [activeTab, setActiveTab] = useState('dashboard');
  const [isMobileOpen, setIsMobileOpen] = useState(false);

  const renderContent = () => {
    switch (activeTab) {
      case 'dashboard': return <DashboardView />;
      case 'schedule': return <ScheduleView />;
      case 'gpa': return <GPACalculatorView />; 
      case 'library': return <LibraryDocsView />; 
      case 'reports': return <ReportsView />; // Added Reports View
      case 'management': return <ManagementView />;
      case 'staff': return <StaffView />; 
      case 'teachers': return <TeachersView />; 
      case 'payroll': return <PayrollView />; 
      case 'academic': return <AcademicSystemView />;
      case 'students': return <StudentsView />; 
      case 'courses': return <CoursesView />; 
      case 'finance': return <FinanceView />;
      default:
        return (
          <div className="flex flex-col items-center justify-center h-64 text-slate-400">
            <Settings size={48} className="mb-4" />
            <p className="text-lg">កំពុងអភិវឌ្ឍន៍ ({activeTab})</p>
          </div>
        );
    }
  };

  return (
    <div className="flex h-screen bg-slate-100 font-sans">
      <Sidebar 
        activeTab={activeTab} 
        setActiveTab={setActiveTab} 
        isMobileOpen={isMobileOpen}
        setIsMobileOpen={setIsMobileOpen}
      />
      <div className="flex-1 flex flex-col overflow-hidden">
        <header className="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 z-10">
          <div className="flex items-center">
             <button 
                className="mr-4 text-slate-500 md:hidden"
                onClick={() => setIsMobileOpen(true)}
             >
                <Menu size={24} />
             </button>
             <h1 className="text-lg font-bold text-slate-700 hidden md:block">
               ប្រព័ន្ធគ្រប់គ្រងសាកលវិទ្យាល័យ
             </h1>
          </div>

          <div className="flex items-center space-x-4">
            <button className="relative p-2 text-slate-500 hover:bg-slate-100 rounded-full">
              <Bell size={20} />
              <span className="absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white"></span>
            </button>
            <div className="w-8 h-8 rounded-full bg-slate-200 overflow-hidden">
               <div className="w-full h-full bg-blue-500 flex items-center justify-center text-white text-xs">AD</div>
            </div>
          </div>
        </header>

        <main className="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8">
          {renderContent()}
        </main>
      </div>
    </div>
  );
};

export default App;
