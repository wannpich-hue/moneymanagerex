const GPACalculatorView = () => {
    const [courses, setCourses] = useState([{ id: 1, name: 'មុខវិជ្ជាទី ១ (Subject 1)', credit: 3, grade: 'A' }, { id: 2, name: 'មុខវិជ្ជាទី ២ (Subject 2)', credit: 3, grade: 'B' }, { id: 3, name: 'មុខវិជ្ជាទី ៣ (Subject 3)', credit: 3, grade: 'C' }, { id: 4, name: 'មុខវិជ្ជាទី ៤ (Subject 4)', credit: 3, grade: 'A' }]);
    const gradePoints = { 'A+': 4.0, 'A': 4.0, 'A-': 3.7, 'B+': 3.5, 'B': 3.0, 'B-': 2.75, 'C+': 2.5, 'C': 2.0, 'C-': 1.75, 'D': 1.0, 'F': 0.0 };
    const addCourse = () => { const newId = courses.length > 0 ? Math.max(...courses.map(c => c.id)) + 1 : 1; setCourses([...courses, { id: newId, name: '', credit: 3, grade: 'B' }]); };
    const removeCourse = (id) => { setCourses(courses.filter(c => c.id !== id)); };
    const updateCourse = (id, field, value) => { setCourses(courses.map(c => c.id === id ? { ...c, [field]: value } : c)); };
    const calculateResult = () => { let totalPoints = 0; let totalCredits = 0; courses.forEach(course => { const points = gradePoints[course.grade] || 0; const credits = parseFloat(course.credit) || 0; totalPoints += points * credits; totalCredits += credits; }); const gpa = totalCredits > 0 ? (totalPoints / totalCredits).toFixed(2) : '0.00'; return { gpa, totalCredits, totalPoints: totalPoints.toFixed(1) }; };
    const result = calculateResult();
    return (<div className="space-y-6"><h2 className="text-2xl font-bold text-slate-800 flex items-center"><PieChart className="mr-3 text-blue-600" /> គណនាមធ្យមភាគ GPA (GPA Calculator)</h2><div className="grid grid-cols-1 lg:grid-cols-3 gap-6"><div className="lg:col-span-2"><div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden"><div className="p-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center"><h3 className="font-bold text-slate-700">បញ្ចូលពិន្ទុតាមមុខវិជ្ជា</h3><button onClick={addCourse} className="flex items-center text-sm bg-blue-600 text-white px-3 py-1.5 rounded hover:bg-blue-700 transition-colors"><PlusCircle size={16} className="mr-1" /> បន្ថែមមុខវិជ្ជា</button></div><div className="p-4"><div className="space-y-3">{courses.map((course, index) => (<div key={course.id} className="flex flex-col sm:flex-row gap-3 items-end sm:items-center bg-slate-50 p-3 rounded-lg border border-slate-100"><div className="flex-1 w-full"><label className="block text-xs font-medium text-slate-500 mb-1">ឈ្មោះមុខវិជ្ជា (Subject)</label><input type="text" value={course.name} onChange={(e) => updateCourse(course.id, 'name', e.target.value)} placeholder={`មុខវិជ្ជាទី ${index + 1}`} className="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" /></div><div className="w-full sm:w-24"><label className="block text-xs font-medium text-slate-500 mb-1">ក្រេឌីត (Credit)</label><select value={course.credit} onChange={(e) => updateCourse(course.id, 'credit', e.target.value)} className="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">{[1, 1.5, 2, 2.5, 3, 3.5, 4, 5, 6].map(c => (<option key={c} value={c}>{c}</option>))}</select></div><div className="w-full sm:w-32"><label className="block text-xs font-medium text-slate-500 mb-1">និទ្ទេស (Grade)</label><select value={course.grade} onChange={(e) => updateCourse(course.id, 'grade', e.target.value)} className="w-full px-3 py-2 border border-slate-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm font-bold text-blue-700">{Object.keys(gradePoints).map(g => (<option key={g} value={g}>{g} ({gradePoints[g]})</option>))}</select></div><button onClick={() => removeCourse(course.id)} className="p-2 text-red-400 hover:text-red-600 hover:bg-red-50 rounded transition-colors mb-0.5"><X size={20} /></button></div>))}</div></div></div></div><div className="lg:col-span-1"><div className="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-xl p-6 text-white shadow-lg sticky top-6"><h3 className="text-lg font-medium text-blue-100 mb-2">លទ្ធផល GPA សរុប</h3><div className="flex items-baseline mb-6"><span className="text-5xl font-bold">{result.gpa}</span><span className="text-blue-200 ml-2 text-sm">/ 4.00</span></div><div className="space-y-3 pt-4 border-t border-blue-500/30"><div className="flex justify-between text-sm"><span className="text-blue-100">ក្រេឌីតសរុប (Total Credits)</span><span className="font-bold">{result.totalCredits}</span></div><div className="flex justify-between text-sm"><span className="text-blue-100">ពិន្ទុគុណសរុប (Total Points)</span><span className="font-bold">{result.totalPoints}</span></div></div><div className="mt-8 bg-white/10 p-4 rounded-lg backdrop-blur-sm"><h4 className="font-bold text-sm mb-2 flex items-center"><BookOpen size={14} className="mr-2"/> ប្រព័ន្ធពិន្ទុយោង</h4><div className="grid grid-cols-2 gap-2 text-xs text-blue-100"><div>A = 4.0 (90-100%)</div><div>B = 3.0 (73-76%)</div><div>C = 2.0 (63-66%)</div><div>D = 1.0 (50-59%)</div></div></div></div></div></div></div>);
};

const FinanceView = () => {
  const [activeFinanceTab, setActiveFinanceTab] = useState('overview'); 
  const [financialAdvice, setFinancialAdvice] = useState('');
  const [loadingAdvice, setLoadingAdvice] = useState(false);
  const totalIncome = initialIncomes.reduce((acc, curr) => acc + curr.amount, 0);
  const totalExpense = initialExpenses.reduce((acc, curr) => acc + curr.amount, 0);
  const balance = totalIncome - totalExpense;
  const handleGenerateAdvice = async () => { setLoadingAdvice(true); setFinancialAdvice(''); const prompt = `Analyze these school finance figures: Income $${totalIncome}, Expense $${totalExpense}, Balance $${balance}. Give a financial health summary in Khmer and 3 actionable tips. Use emojis.`; const response = await generateGeminiResponse(prompt); setFinancialAdvice(response); setLoadingAdvice(false); };
  return (<div className="space-y-6"><div className="flex justify-between items-center"><h2 className="text-2xl font-bold text-slate-800">ហិរញ្ញវត្ថុ & លំហូរសាច់ប្រាក់</h2></div><div className="flex flex-wrap gap-2 items-center"><div className="flex space-x-2 bg-slate-100 p-1 rounded-lg w-fit"><button onClick={() => setActiveFinanceTab('overview')} className={`px-4 py-2 rounded-md text-sm font-medium transition-all ${activeFinanceTab === 'overview' ? 'bg-white text-blue-600 shadow-sm' : 'text-slate-600 hover:text-slate-800'}`}>ស្ថានភាពសាច់ប្រាក់ (Charts)</button><button onClick={() => setActiveFinanceTab('income')} className={`px-4 py-2 rounded-md text-sm font-medium transition-all ${activeFinanceTab === 'income' ? 'bg-white text-green-600 shadow-sm' : 'text-slate-600 hover:text-slate-800'}`}>ចំណូល (Income)</button><button onClick={() => setActiveFinanceTab('expense')} className={`px-4 py-2 rounded-md text-sm font-medium transition-all ${activeFinanceTab === 'expense' ? 'bg-white text-red-600 shadow-sm' : 'text-slate-600 hover:text-slate-800'}`}>ចំណាយ (Expenses)</button></div></div>{activeFinanceTab === 'overview' && (<div className="space-y-6 animate-in fade-in duration-300"><div className="bg-gradient-to-r from-blue-50 to-indigo-50 p-6 rounded-xl border border-blue-100"><div className="flex justify-between items-start mb-4"><h3 className="font-bold text-blue-800 flex items-center text-lg"><BrainCircuit className="mr-2" size={24} /> AI វិភាគហិរញ្ញវត្ថុ (Financial Health Check)</h3><button onClick={handleGenerateAdvice} disabled={loadingAdvice} className="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center shadow-sm disabled:opacity-70">{loadingAdvice ? <Loader2 className="animate-spin mr-2" size={16} /> : <Sparkles size={16} className="mr-2" />} វិភាគទិន្នន័យ</button></div>{financialAdvice && (<div className="bg-white p-4 rounded-lg border border-blue-200 text-slate-700 text-sm whitespace-pre-wrap le