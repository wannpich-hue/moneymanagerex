                                  <MapPin size={10} className="mr-1" /> {schedule.room}
                                </span>
                                <button className="opacity-0 group-hover:opacity-100 transition-opacity p-1 bg-white rounded-full text-blue-600 hover:text-blue-800 shadow-sm">
