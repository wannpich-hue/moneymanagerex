const ManagementView = () => {
    const [meetingTopic, setMeetingTopic] = useState('');
    const [agenda, setAgenda] = useState('');
    const [loadingAgenda, setLoadingAgenda] = useState(false);
    const handleGenerateAgenda = async () => { if (!meetingTopic) return; setLoadingAgenda(true); setAgenda(''); const prompt = `Create a structured meeting agenda in Khmer for the topic: "${meetingTopic}". Include: Objective, 3-4 Agenda Items, Closing. Use emojis.`; const response = await generateGeminiResponse(prompt); setAgenda(response); setLoadingAgenda(false); };
    return (<div className="space-y-6"><div className="flex justify-between items-center"><h2 className="text-2xl font-bold text-slate-800">គណៈគ្រប់គ្រង</h2><button className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">បន្ថែមសមាជិក</button></div><div className="bg-gradient-to-r from-cyan-50 to-sky-50 p-6 rounded-xl border border-cyan-100 shadow-sm"><h3 className="font-bold text-cyan-900 mb-4 flex items-center text-lg"><ClipboardList className="mr-2" size={24} /> AI បង្កើតរបៀបវារៈប្រជុំ (Meeting Agenda Generator)</h3><div className="flex flex-col md:flex-row gap-3"><input type="text" placeholder="បញ្ចូលប្រធានបទប្រជុំ..." className="w-full md:w-2/3 px-4 py-2 border border-cyan-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500" value={meetingTopic} onChange={(e) => setMeetingTopic(e.target.value)} /><button onClick={handleGenerateAgenda} disabled={loadingAgenda || !meetingTopic} className="px-6 py-2 bg-cyan-600 text-white rounded-lg hover:bg-cyan-700 transition-colors disabled:opacity-70 flex items-center justify-center font-medium">{loadingAgenda ? <Loader2 className="animate-spin mr-2" size={18} /> : <Sparkles className="mr-2" size={18} />} រៀបចំរបៀបវារៈ</button></div>{agenda && (<div className="mt-4 bg-white p-5 rounded-xl border border-cyan-200 text-slate-700 text-sm whitespace-pre-wrap leading-relaxed shadow-sm animate-in fade-in slide-in-from-top-2"><div className="flex justify-between items-start mb-2 pb-2 border-b border-cyan-50"><h4 className="font-bold text-cyan-800">របៀបវារៈសម្រាប់: {meetingTopic}</h4><button onClick={() => setAgenda('')} className="text-slate-400 hover:text-slate-600"><X size={16} /></button></div>{agenda}</div>)}</div><div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">{initialManagement.map((member) => (<div key={member.id} className="bg-white p-6 rounded-xl shadow-sm border border-slate-200 relative overflow-hidden group"><div className="absolute top-0 left-0 w-2 h-full bg-orange-500"></div><div className="flex items-start"><div className="w-16 h-16 bg-orange-100 rounded-lg flex items-center justify-center text-orange-500 mb-4 mr-4"><UserCog size={32} /></div><div><h3 className="text-lg font-bold text-slate-800">{member.name}</h3><p className="text-orange-600 text-sm font-medium mb-1">{member.position}</p><p className="text-slate-500 text-xs">{member.email}</p></div></div></div>))}</div></div>);
};

