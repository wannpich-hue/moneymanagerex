// --- NEW: Reports View Component ---
const ReportsView = () => {
  const [reportType, setReportType] = useState('student');
  const [processing, setProcessing] = useState(null);

  // Simulation of export actions
  const handleAction = (action) => {
    setProcessing(action);
    // Simulate delay
    setTimeout(() => {
      setProcessing(null);
      // In a real app, this would trigger a download or print dialog
    }, 2000);
  };

  const getReportTitle = () => {
    switch(reportType) {
      case 'student': return 'របាយការណ៍សរុបនិស្សិត (Student Summary)';
      case 'finance': return 'របាយការណ៍ហិរញ្ញវត្ថុប្រចាំខែ (Monthly Finance)';
      case 'staff': return 'របាយការណ៍បុគ្គលិក & ប្រាក់បៀវត្ស (Staff & Payroll)';
      case 'academic': return 'របាយការណ៍លទ្ធផលសិក្សា (Academic Result)';
      default: return 'របាយការណ៍ទូទៅ';
    }
  };

  return (
    <div className="space-y-6">
       <h2 className="text-2xl font-bold text-slate-800 flex items-center">
          <FileBarChart className="mr-3 text-blue-600" />
          របាយការណ៍ & នាំចេញឯកសារ (Reports & Exports)
       </h2>

       {/* 1. Report Selector */}
       <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
         {[
           { id: 'student', label: 'និស្សិត', icon: <Users size={20} /> },
           { id: 'finance', label: 'ហិរញ្ញវត្ថុ', icon: <DollarSign size={20} /> },
           { id: 'staff', label: 'បុគ្គលិក', icon: <Briefcase size={20} /> },
           { id: 'academic', label: 'សិក្សា', icon: <GraduationCap size={20} /> }
         ].map(type => (
            <button 
              key={type.id}
              onClick={() => setReportType(type.id)}
              className={`p-4 rounded-xl border-2 flex flex-col items-center justify-center transition-all ${
                reportType === type.id 
                ? 'border-blue-600 bg-blue-50 text-blue-700 font-bold shadow-sm' 
                : 'border-slate-200 bg-white text-slate-600 hover:border-blue-300'
              }`}
            >
               <div className={`mb-2 p-2 rounded-full ${reportType === type.id ? 'bg-blue-200' : 'bg-slate-100'}`}>
                 {type.icon}
               </div>
               {type.label}
            </button>
         ))}
       </div>

       {/* 2. Action Bar (Export Options) */}
       <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap gap-3 items-center justify-between">
          <div className="flex items-center gap-2">
             <span className="text-sm font-bold text-slate-700">រក្សាទុកជា (Save As):</span>
             <button onClick={() => handleAction('pdf')} className="flex items-center px-3 py-2 bg-red-50 text-red-700 rounded-lg border border-red-200 hover:bg-red-100 transition-colors text-sm font-medium">
                {processing === 'pdf' ? <Loader2 className="animate-spin mr-2" size={16} /> : <FileType size={16} className="mr-2" />}
                PDF
             </button>
             <button onClick={() => handleAction('excel')} className="flex items-center px-3 py-2 bg-green-50 text-green-700 rounded-lg border border-green-200 hover:bg-green-100 transition-colors text-sm font-medium">
                {processing === 'excel' ? <Loader2 className="animate-spin mr-2" size={16} /> : <FileSpreadsheet size={16} className="mr-2" />}
                Excel
             </button>
             <button onClick={() => handleAction('word')} className="flex items-center px-3 py-2 bg-blue-50 text-blue-700 rounded-lg border border-blue-200 hover:bg-blue-100 transition-colors text-sm font-medium">
                {processing === 'word' ? <Loader2 className="animate-spin mr-2" size={16} /> : <FileText size={16} className="mr-2" />}
                Word
             </button>
          </div>
          <div className="flex items-center gap-2 border-l pl-4 border-slate-200">
             <button onClick={() => handleAction('share')} className="flex items-center px-3 py-2 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors text-sm">
                {processing === 'share' ? <Loader2 className="animate-spin mr-2" size={16} /> : <Share2 size={16} className="mr-2" />}
                ចែករំលែក (Share)
             </button>
             <button onClick={() => { handleAction('print'); }} className="flex items-center px-3 py-2 bg-slate-800 text-white rounded-lg hover:bg-slate-900 transition-colors text-sm font-medium shadow-sm">
                 {processing === 'print' ? <Loader2 className="animate-spin mr-2" size={16} /> : <Printer size={16} className="mr-2" />}
                 បោះពុម្ព (Print)
             </button>
          </div>
       </div>

       {/* Notification Toast Simulation */}
       {processing && (
          <div className="fixed bottom-6 right-6 bg-slate-800 text-white px-6 py-3 rounded-lg shadow-lg flex items-center animate-bounce z-50">
             <Download className="mr-3" size={20} />
             <div>
                <p className="font-bold text-sm">កំពុងដំណើរការ...</p>
                <p className="text-xs text-slate-300">កំពុងបង្កើតឯកសារ {processing.toUpperCase()} សូមរង់ចាំ។</p>
             </div>
          </div>
       )}

       {/* 3. Report Preview (A4 Paper Style) */}
       <div className="bg-slate-200 p-8 rounded-xl overflow-auto flex justify-center min-h-[600px]">
          <div className="bg-white w-[210mm] min-h-[297mm] shadow-2xl p-[20mm] relative">
             {/* Header */}
             <div className="text-center border-b-2 border-slate-800 pb-6 mb-6">
                <h1 className="text-2xl font-bold font-serif mb-2 text-slate-900">សាកលវិទ្យាល័យ ជាតិកម្ពុជា</h1>
                <h2 className="text-xl font-bold text-blue-700 font-serif">CAMBODIA NATIONAL UNIVERSITY</h2>
                <div className="mt-4 text-sm text-slate-500">
                   អាសយដ្ឋាន: ផ្លូវ ១២៣, សង្កាត់ទឹកល្អក់១, ខណ្ឌទួលគោក, ភ្នំពេញ | ទូរស័ព្ទ: 012 345 678
                </div>
             </div>
             
             {/* Report Meta */}
             <div className="flex justify-between items-end mb-8">
                <div>
                   <h3 className="text-lg font-bold text-slate-800 underline decoration-2 underline-offset-4">{getReportTitle()}</h3>
                   <p className="text-sm text-slate-500 mt-2">កាលបរិច្ឆេទបង្កើត: {new Date().toLocaleDateString('km-KH')}</p>
                </div>
                <div className="text-right">
                   <p className="text-sm font-bold">លេខយោង: RPT-{new Date().getFullYear()}-{Math.floor(Math.random() * 1000)}</p>
                   <p className="text-xs text-slate-400">បង្កើតដោយ: Admin User</p>
                </div>
             </div>

             {/* Dynamic Content Based on Type */}
             <div className="space-y-4">
               {reportType === 'student' && (
                 <table className="w-full border-collapse border border-slate-300 text-sm">
                   <thead className="bg-slate-100">
                     <tr>
                       <th className="border border-slate-300 p-2 text-left">ល.រ</th>
                       <th className="border border-slate-300 p-2 text-left">អត្តលេខ</th>
                       <th className="border border-slate-300 p-2 text-left">ឈ្មោះនិស្សិត</th>
                       <th className="border border-slate-300 p-2 text-left">ភេទ</th>
                       <th className="border border-slate-300 p-2 text-left">ជំនាញ</th>
                       <th className="border border-slate-300 p-2 text-center">ស្ថានភាព</th>
                     </tr>
                   </thead>
                   <tbody>
                      {initialStudents.map((s, i) => (
                        <tr key={s.id}>
                          <td className="border border-slate-300 p-2 text-center">{toKhmerNum(i + 1)}</td>
                          <td className="border border-slate-300 p-2">{s.id}</td>
                          <td className="border border-slate-300 p-2 font-bold">{s.nameKh}</td>
                          <td className="border border-slate-300 p-2">{s.gender}</td>
                          <td className="border border-slate-300 p-2">{s.major}</td>
                          <td className="border border-slate-300 p-2 text-center">{s.status}</td>
                        </tr>
                      ))}
                      {/* Fake Rows to fill paper */}
                      {[...Array(5)].map((_, i) => (
                         <tr key={`fake-${i}`}>
                           <td className="border border-slate-300 p-2 text-center">{toKhmerNum(i + 3)}</td>
                           <td className="border border-slate-300 p-2">S00{i+3}</td>
                           <td className="border border-slate-300 p-2 text-slate-300">........................</td>
                           <td className="border border-slate-300 p-2 text-slate-300">...</td>
                           <td className="border border-slate-300 p-2 text-slate-300">........................</td>
                           <td className="border border-slate-300 p-2 text-slate-300">...</td>
                         </tr>
                      ))}
                   </tbody>
                 </table>
               )}

               {reportType === 'finance' && (
                  <div className="space-y-6">
                     <div className="grid grid-cols-2 gap-4">
                        <div className="border border-slate-300 p-4 rounded bg-green-50">
                           <p className="text-slate-500 text-xs uppercase">ចំណូលសរុប (Income)</p>
                           <p className="text-xl font-bold text-green-700">$2,450.00</p>
                        </div>
                        <div className="border border-slate-300 p-4 rounded bg-red-50">
                           <p className="text-slate-500 text-xs uppercase">ចំណាយសរុប (Expense)</p>
                           <p className="text-xl font-bold text-red-700">$2,580.00</p>
                        </div>
                     </div>
                     <table className="w-full border-collapse border border-slate-300 text-sm">
                        <thead className="bg-slate-100">
                          <tr>
                            <th className="border border-slate-300 p-2 text-left">កាលបរិច្ឆេទ</th>
                            <th className="border border-slate-300 p-2 text-left">បរិយាយ</th>
                            <th className="border border-slate-300 p-2 text-right">ចំណូល</th>
                            <th className="border border-slate-300 p-2 text-right">ចំណាយ</th>
                          </tr>
                        </thead>
                        <tbody>
                           <tr className="bg-green-50/30">
                              <td className="border border-slate-300 p-2">01/10/2023</td>
                              <td className="border border-slate-300 p-2">ចំណូលថ្លៃសិក្សា (Tuition Fee)</td>
                              <td className="border border-slate-300 p-2 text-right text-green-600">$500.00</td>
                              <td className="border border-slate-300 p-2 text-right">-</td>
                           </tr>
                           <tr className="bg-red-50/30">
                              <td className="border border-slate-300 p-2">03/10/2023</td>
                              <td className="border border-slate-300 p-2">ទិញសម្ភារៈការិយាល័យ</td>
                              <td className="border border-slate-300 p-2 text-right">-</td>
                              <td className="border border-slate-300 p-2 text-right text-red-600">$150.00</td>
                           </tr>
                           <tr className="bg-green-50/30">
                              <td className="border border-slate-300 p-2">10/10/2023</td>
                              <td className="border border-slate-300 p-2">ចំណូលថ្លៃសិក្សា (Tuition Fee)</td>
                              <td className="border border-slate-300 p-2 text-right text-green-600">$600.00</td>
                              <td className="border border-slate-300 p-2 text-right">-</td>
                           </tr>
                        </tbody>
                     </table>
                  </div>
               )}

               {(reportType === 'staff' || reportType === 'academic') && (
                  <div className="text-center py-20 text-slate-400">
                     <FileBarChart size={64} className="mx-auto mb-4 opacity-20" />
                     <p>ទិន្នន័យគំរូសម្រាប់ផ្នែកនេះនឹងបង្ហាញនៅពេលមានទិន្នន័យជាក់ស្តែង។</p>
                     <p className="text-xs mt-2">សូមជ្រើសរើសផ្នែកផ្សេងដើម្បីមើលគំរូ។</p>
                  </div>
               )}
             </div>

             {/* Footer */}
             <div className="absolute bottom-[20mm] left-[20mm] right-[20mm]">
                <div className="flex justify-between mt-10">
                   <div className="text-center">
                      <p className="text-sm font-bold mb-16">ហត្ថលេខាអ្នករៀបចំ</p>
                      <p className="text-sm">.......................................</p>
                   </div>
                   <div className="text-center">
                      <p className="text-sm font-bold mb-16">ហត្ថលេខានាយកសាលា</p>
                      <p className="text-sm">.......................................</p>
                   </div>
                </div>
                <div className="text-center mt-10 border-t border-slate-200 pt-4 text-xs text-slate-400">
                   របាយការណ៍នេះបង្កើតដោយប្រព័ន្ធស្វ័យប្រវត្តិ UniSystem KH នៅថ្ងៃ {new Date().toLocaleString('km-KH')}
                </div>
             </div>
          </div>
       </div>
    </div>
  );
};


const DashboardView = () => {
  const [insight, setInsight] = useState('');
  const [loadingInsight, setLoadingInsight] = useState(false);
  const [suggestedEvents, setSuggestedEvents] = useState('');
  const [loadingEvents, setLoadingEvents] = useState(false);
  const [announcementTopic, setAnnouncementTopic] = useState('');
  const [announcement, setAnnouncement] = useState('');
  const [loadingAnnouncement, setLoadingAnnouncement] = useState(false);

  const stats = [
    { label: 'និស្សិតសរុប', value: '1,234', icon: <Users className="text-blue-500" />, color: 'bg-blue-100' },
    { label: 'គ្រូបង្រៀន', value: '56', icon: <GraduationCap className="text-green-500" />, color: 'bg-green-100' },
    { label: 'ឯកសារបណ្ណាល័យ', value: '520', icon: <Library className="text-indigo-500" />, color: 'bg-indigo-100' },
    { label: 'ចំណូលខែនេះ', value: '$12,500', icon: <DollarSign className="text-yellow-500" />, color: 'bg-yellow-100' },
  ];

  const getKhmerMonth = () => ['មករា', 'កុម្ភៈ', 'មីនា', 'មេសា', 'ឧសភា', 'មិថុនា', 'កក្កដា', 'សីហា', 'កញ្ញា', 'តុលា', 'វិច្ឆិកា', 'ធ្នូ'][new Date().getMonth()];
  const getKhmerDate = () => {
    const days = ['អាទិត្យ', 'ច័ន្ទ', 'អង្គារ', 'ពុធ', 'ព្រហស្បតិ៍', 'សុក្រ', 'សៅរ៍'];
    const date = new Date();
    return `ថ្ងៃ${days[date.getDay()]} ទី${toKhmerNum(date.getDate())} ខែ${getKhmerMonth()} ឆ្នាំ${toKhmerNum(date.getFullYear())}`;
  };

  const renderCalendarDays = () => {
    const date = new Date();
    const currentDay = date.getDate();
    const daysInMonth = new Date(date.getFullYear(), date.getMonth() + 1, 0).getDate();
    const firstDayIndex = new Date(date.getFullYear(), date.getMonth(), 1).getDay();
    const days = [];
    for (let i = 0; i < firstDayIndex; i++) days.push(<div key={`empty-${i}`} className="h-9 w-9"></div>);
    for (let i = 1; i <= daysInMonth; i++) {
        const isToday = i === currentDay;
        days.push(<div key={`day-${i}`} className={`h-9 w-9 flex items-center justify-center rounded-full text-sm font-bold cursor-pointer transition-colors ${isToday ? 'bg-blue-600 text-white shadow-md' : 'text-slate-700 hover:bg-slate-100'}`}>{toKhmerNum(i)}</div>);
    }
    return days;
  };

  const handleGenerateInsight = async () => {
      setLoadingInsight(true); setInsight('');
      const prompt = "Give a short, motivational quote or management tip for school leaders in Khmer. Use an encouraging tone and emojis.";
      const response = await generateGeminiResponse(prompt);
      setInsight(response); setLoadingInsight(false);
  };

  const handleSuggestEvents = async () => {
      setLoadingEvents(true); setSuggestedEvents('');
      const prompt = `Suggest 3 school activities or events suitable for the month of "${getKhmerMonth()}" in Cambodia (e.g. holidays, academic milestones). Language: Khmer. Format: Bullet points with emojis.`;
      const response = await generateGeminiResponse(prompt);
      setSuggestedEvents(response); setLoadingEvents(false);
  };

  const handleGenerateAnnouncement = async () => {
    if (!announcementTopic) return;
    setLoadingAnnouncement(true); setAnnouncement('');
    const prompt = `Write a formal school announcement/notice in Khmer about: "${announcementTopic}". Include: Formal Heading, Body (polite, clear, and administrative tone), Date and Closing. Use emojis.`;
    const response = await generateGeminiResponse(prompt);
    setAnnouncement(response); setLoadingAnnouncement(false);
  };

  return (
    <div className="space-y-6">
      <h2 className="text-2xl font-bold text-slate-800">ទិដ្ឋភាពទូទៅ</h2>
      <div className="bg-gradient-to-r from-violet-500 to-fuchsia-600 rounded-xl p-6 text-white shadow-lg relative overflow-hidden">
          <div className="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
              <div className="flex-1">
                  <h3 className="text-lg font-bold flex items-center mb-2 text-violet-100"><Lightbulb className="mr-2 text-yellow-300" size={24} /> AI ជំនួយការប្រចាំថ្ងៃ (Daily Insight)</h3>
                  {insight ? <p className="text-white text-lg font-medium leading-relaxed italic">"{insight}"</p> : <p className="text-violet-100 text-sm opacity-80">ចុចប៊ូតុងដើម្បីទទួលបានគន្លឹះដឹកនាំ ឬពាក្យលើកទឹកចិត្តប្រចាំថ្ងៃ។</p>}
              </div>
              <button onClick={handleGenerateInsight} disabled={loadingInsight} className="bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-lg text-sm font-bold transition-all backdrop-blur-sm border border-white/40 flex items-center whitespace-nowrap">{loadingInsight ? <Loader2 className="animate-spin mr-2" size={16} /> : <Sparkles className="mr-2" size={16} />} ទទួលសារថ្មី</button>
          </div>
          <div className="absolute right-0 top-0 opacity-10 transform translate-x-10 -translate-y-10"><Brain size={150} /></div>
      </div>
      <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">{stats.map((stat, index) => (<div key={index} className="p-6 bg-white rounded-xl shadow-sm border border-slate-200"><div className="flex items-center justify-between"><div><p className="text-sm font-medium text-slate-500">{stat.label}</p><p className="text-2xl font-bold text-slate-800 mt-1">{stat.value}</p></div><div className={`p-3 rounded-full ${stat.color}`}>{stat.icon}</div></div></div>))}</div>
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div className="lg:col-span-2 space-y-6">
            <div className="bg-gradient-to-r from-pink-50 to-rose-50 p-6 rounded-xl border border-pink-100 shadow-sm">
                <div className="flex flex-col md:flex-row gap-4 justify-between items-start md:items-center mb-4"><h3 className="font-bold text-pink-900 flex items-center text-lg"><Megaphone className="mr-2" size={24} /> AI បង្កើតសេចក្តីជូនដំណឹង (Announcement Generator)</h3></div>
                <div className="flex flex-col md:flex-row gap-3"><input type="text" placeholder="ប្រធានបទ (ឧទាហរណ៍: ឈប់សម្រាកបុណ្យជាតិ...)" className="w-full md:flex-1 px-4 py-2 border border-pink-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-pink-500" value={announcementTopic} onChange={(e) => setAnnouncementTopic(e.target.value)} /><button onClick={handleGenerateAnnouncement} disabled={loadingAnnouncement || !announcementTopic} className="px-6 py-2 bg-pink-600 text-white rounded-lg hover:bg-pink-700 transition-colors disabled:opacity-70 flex items-center justify-center font-medium whitespace-nowrap">{loadingAnnouncement ? <Loader2 className="animate-spin mr-2" size={18} /> : <Sparkles className="mr-2" size={18} />} បង្កើតជូនដំណឹង</button></div>
                {announcement && (<div className="mt-4 bg-white p-5 rounded-xl border border-pink-200 text-slate-700 text-sm whitespace-pre-wrap leading-relaxed shadow-sm animate-in fade-in slide-in-from-top-2"><div className="flex justify-between items-start mb-2 pb-2 border-b border-pink-50"><h4 className="font-bold text-pink-800">លទ្ធផល៖</h4><button onClick={() => setAnnouncement('')} className="text-slate-400 hover:text-slate-600"><X size={16} /></button></div>{announcement}</div>)}
            </div>
            <div className="bg-white p-6 rounded-xl shadow-sm border border-slate-200"><h3 className="text-lg font-bold text-slate-800 mb-4 flex items-center justify-between"><span>សកម្មភាពថ្មីៗ</span><button className="text-sm text-blue-600 hover:underline">មើលទាំងអស់</button></h3><div className="space-y-4"><div className="flex items-start pb-4 border-b border-slate-100"><div className="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600 mr-3 mt-1"><UserPlus size={18} /></div><div><p className="text-slate-800 font-medium">និស្សិតថ្មី ៥ នាក់បានចុះឈ្មោះ</p><p className="text-slate-500 text-sm">ថ្នាក់បរិញ្ញាបត្ររង ជំនាញគ្រប់គ្រង</p><p className="text-slate-400 text-xs mt-1">២ ម៉ោងមុន</p></div></div><div className="flex items-start pb-4 border-b border-slate-100"><div className="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 mr-3 mt-1"><DollarSign size={18} /></div><div><p className="text-slate-800 font-medium">ទទួលបានការបង់ថ្លៃសិក្សា</p><p className="text-slate-500 text-sm">ពីនិស្សិតឈ្មោះ សុខ វិបុល ($500)</p><p className="text-slate-400 text-xs mt-1">៥ ម៉ោងមុន</p></div></div></div></div>
          </div>
          <div className="lg:col-span-1"><div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200"><div className="flex items-center justify-between mb-4"><h3 className="font-bold text-slate-800 flex items-center text-lg"><Calendar className="mr-2 text-red-600" size={20}/> ប្រតិទិនខ្មែរ</h3></div><div className="bg-blue-800 rounded-t-xl p-4 text-center border-b-4 border-red-600"><h4 className="text-white font-bold text-2xl mb-1">{getKhmerMonth()}</h4><p className="text-blue-100 font-medium text-sm">{getKhmerDate()}</p></div><div className="bg-slate-50 p-4 rounded-b-xl border border-t-0 border-slate-200"><div className="grid grid-cols-7 gap-1 text-center text-sm mb-2">{['អា', 'ច', 'អ', 'ព', 'ព្រ', 'សុ', 'ស'].map((d, i) => (<div key={d} className={`text-xs font-bold py-1 ${i===0 ? 'text-red-600' : 'text-slate-500'}`}>{d}</div>))}</div><div className="grid grid-cols-7 gap-1 justify-items-center">{renderCalendarDays()}</div></div><div className="mt-4 pt-4 border-t border-slate-100"><button onClick={handleSuggestEvents} disabled={loadingEvents} className="flex items-center justify-center w-full py-2.5 bg-orange-50 text-orange-700 font-medium rounded-lg hover:bg-orange-100 transition-colors mb-4 border border-orange-200">{loadingEvents ? <Loader2 size={16} className="animate-spin mr-2" /> : <PartyPopper size={16} className="mr-2" />} ស្នើព្រឹត្តិការណ៍សម្រាប់ខែនេះ</button>{suggestedEvents ? (<div className="bg-orange-50 p-3 rounded-lg border border-orange-100 text-sm text-slate-700 mb-3 animate-in fade-in"><h5 className="font-bold text-orange-800 mb-2 text-xs uppercase">សកម្មភាពដែលបានស្នើ៖</h5><div className="whitespace-pre-wrap leading-relaxed">{suggestedEvents}</div></div>) : (<><h5 className="font-bold text-slate-700 text-sm mb-3">ព្រឹត្តិការណ៍ខាងមុខ</h5><div className="space-y-3"><div className="flex items-center gap-3 p-2 hover:bg-slate-50 rounded-lg transition-colors cursor-pointer"><div className="w-12 h-12 bg-blue-50 rounded-lg flex flex-col items-center justify-center text-blue-600 border border-blue-100"><span className="font-bold text-lg leading-none">{toKhmerNum(15)}</span><span className="text-[10px] uppercase">ធ្នូ</span></div><div><p className="font-medium text-slate-800 text-sm">ប្រជុំគណៈគ្រប់គ្រង</p><p className="text-xs text-slate-500">ម៉ោង ៩:០០ ព្រឹក</p></div></div></div></>)}</div></div></div>
      </div>
    </div>
  );
};

const ScheduleView = () => {
  const [activeShift, setActiveShift] = useState('weekday'); 

  const shifts = [
    { id: 'weekday', label: 'វេនសិក្សា ច័ន្ទ-សុក្រ (Weekday)' },
    { id: 'weekend', label: 'វេនសិក្សា សៅរ៍-អាទិត្យ (Weekend)' }
  ];

  const days = activeShift === 'weekday' 
    ? ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday']
    : ['Saturday', 'Sunday'];

  const dayLabels = {
    'Monday': 'ថ្ងៃច័ន្ទ',
    'Tuesday': 'ថ្ងៃអង្គារ',
    'Wednesday': 'ថ្ងៃពុធ',
    'Thursday': 'ថ្ងៃព្រហស្បតិ៍',
    'Friday': 'ថ្ងៃសុក្រ',
    'Saturday': 'ថ្ងៃសៅរ៍',
    'Sunday': 'ថ្ងៃអាទិត្យ'
  };

  return (
    <div className="space-y-6">
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <h2 className="text-2xl font-bold text-slate-800 flex items-center">
          <CalendarClock className="mr-3 text-blue-600" />
          កាលវិភាគ & ម៉ោងបង្រៀនសាស្ត្រាចារ្យ
        </h2>
        <div className="bg-slate-100 p-1 rounded-lg flex">
          {shifts.map((shift) => (
            <button
              key={shift.id}
              onClick={() => setActiveShift(shift.id)}
              className={`px-4 py-2 rounded-md text-sm font-medium transition-all ${
                activeShift === shift.id
                  ? 'bg-white text-blue-700 shadow-sm'
                  : 'text-slate-500 hover:text-slate-800'
              }`}
            >
              {shift.label}
            </button>
          ))}
        </div>
      </div>

      <div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div className="overflow-x-auto">
          <div className="min-w-[1000px]">
            <div className="grid grid-cols-[150px_repeat(auto-fit,minmax(180px,1fr))] border-b border-slate-200">
              <div className="p-4 bg-slate-50 font-bold text-slate-700 border-r border-slate-200 flex items-center justify-center">
                ម៉ោង / ថ្ងៃ
              </div>
              {days.map(day => (
                <div key={day} className="p-4 bg-slate-50 font-bold text-slate-700 border-r border-slate-200 last:border-r-0 text-center uppercase">
                  {dayLabels[day]}
                </div>
              ))}
            </div>
            {timeSlots.map((slot) => {
              const isBreak = slot.type === 'BREAK';
              return (
                <div key={slot.id} className={`grid grid-cols-[150px_repeat(auto-fit,minmax(180px,1fr))] border-b border-slate-100 last:border-b-0 ${isBreak ? 'bg-orange-50/50' : 'hover:bg-slate-50'}`}>
                  <div className={`p-4 border-r border-slate-200 flex flex-col justify-center text-sm ${isBreak ? 'text-orange-600 font-bold items-center' : 'text-slate-600'}`}>
                    {isBreak ? (
                      <div className="flex items-center"><Coffee size={16} className="mr-2"/> ចេញលេង</div>
                    ) : (
                      <>
                        <span className="font-bold text-slate-800">{slot.label}</span>
                        <span className="text-xs text-slate-500 mt-1">{slot.session}</span>
                      </>
                    )}
                  </div>
                  {isBreak ? (
                    <div className="col-span-full p-2 flex items-center justify-center text-orange-400 text-xs font-medium tracking-widest uppercase">
                      Break Time ({slot.label})
                    </div>
                  ) : (
                    days.map((day, idx) => {
                      const schedule = mockScheduleData[activeShift][day]?.[slot.id];
                      return (
                        <div key={`${day}-${slot.id}`} className="p-3 border-r border-slate-200 last:border-r-0 relative group">
